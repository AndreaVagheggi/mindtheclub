    <string name="stealth_mode_help">Mode siluman memaksa lalu lintas melewati relai (TURN). Ini menyembunyikan informasi jaringan Anda dari orang yang sedang Anda ajak mengobrol.</string>
    <string name="bluetooth_transport_help">Saat aktif, MindTheClub dapat mengirim pesan langsung melalui Bluetooth ke kontak terdekat, tanpa internet, Wi-Fi, atau data seluler. Berguna saat Anda offline atau tidak ada sinyal. Orang lain juga harus mengaktifkan Bluetooth dan terhubung dengan perangkat Anda.</string>
    <string name="auto_invite_mode_help">Saat aktif, siapa pun yang memindai kode QR Anda atau mengetuk tautan undangan Anda akan diterima secara otomatis dan langsung ditambahkan ke daftar kontak Anda sebagai tertunda. Mereka tidak lagi muncul di layar Permintaan kontak baru untuk persetujuan manual. Nonaktifkan jika Anda lebih suka meninjau dan menerima setiap permintaan sendiri.</string>

    <!-- Onboarding -->
    <string name="onboarding_welcome">Selamat datang di klub!</string>
    <string name="onboarding_subtitle">Perpesanan pribadi, hanya antara Anda dan orang yang Anda pilih. Pilih nama untuk memulai, Anda selalu dapat mengubahnya nanti.</string>
    <string name="onboarding_next">Berikutnya</string>

    <!-- Onboarding: profile (picture + bio) -->
    <string name="onboarding_profile_title">Sesuaikan milik Anda</string>
    <string name="onboarding_profile_subtitle">Tambahkan foto profil dan bio singkat agar orang mengenali Anda. Keduanya opsional, ketuk Berikutnya untuk melewati, Anda dapat menambahkannya kapan saja.</string>

    <!-- Onboarding: invite friends -->
    <string name="onboarding_invite_title">Lebih seru bersama teman</string>
    <string name="onboarding_invite_subtitle">MindTheClub menghubungkan Anda langsung dengan orang yang Anda undang, dan tidak dengan orang lain. Kirim undangan pertama Anda untuk mulai mengobrol: itulah satu langkah yang memulai percakapan.</string>
    <string name="onboarding_invite_skip">Lewati dulu</string>

    <!-- Onboarding: permission priming -->
    <string name="onboarding_perm_title">Sebelum memulai</string>
    <string name="onboarding_perm_calls_title">Panggilan suara &amp; video</string>
    <string name="onboarding_perm_calls_body">MindTheClub memerlukan mikrofon dan kamera Anda agar Anda bisa berbicara dan saling melihat selama panggilan. Dengan mengizinkan sekarang, panggilan langsung berfungsi, tanpa perlu mengizinkan apa pun di tengah panggilan.</string>
    <string name="onboarding_perm_notif_title">Notifikasi</string>
    <string name="onboarding_perm_notif_body">Izinkan notifikasi agar Anda tidak pernah melewatkan pesan baru atau panggilan masuk.</string>
    <string name="onboarding_perm_allow">Izinkan akses</string>
    <string name="onboarding_perm_skip">Nanti saja</string>

