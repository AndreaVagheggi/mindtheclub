<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer Transparent Area (Keeps the layout clean) -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent"/>
        </shape>
    </item>

    <!-- Larger White Circle Effect -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent"/> <!-- Transparent inside -->
            <stroke android:width="60dp" android:color="@android:color/white"/> <!-- White ring -->
            <size android:width="200dp" android:height="200dp"/> <!-- Larger than button -->
        </shape>
    </item>

</layer-list>
