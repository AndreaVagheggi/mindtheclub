<?xml version="1.0" encoding="utf-8"?>
<shape
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- A large radius creates a pill shape.
         Adjust the radius value based on your popup’s height.
         The larger the radius, the more "pill-like" the shape. -->
    <corners android:radius="50dp" />

    <solid android:color="@android:color/white" />

    <!-- Optional: Add a stroke for an outline -->
    <stroke
        android:width="1dp"
        android:color="#33000000" />

    <padding
        android:top="2dp"
        android:bottom="2dp"
        android:left="4dp"
        android:right="4dp" />
</shape>
