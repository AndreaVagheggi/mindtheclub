    <!-- AI Assistant -->
    <string name="assistant_name">Clubby</string>
    <string name="show_clubby">Mostra Clubby</string>
    <string name="show_clubby_help">Clubby è l\'assistente IA integrato. Quando questa opzione è disattivata, Clubby scompare dalla tua lista contatti e dai risultati di ricerca. La conversazione viene conservata e riappare non appena la riattivi.</string>
    <string name="assistant_bio">Assistente IA — i messaggi di questa chat vengono elaborati da un modello IA, non peer-to-peer</string>
    <string name="assistant_welcome">Ciao! Sono Clubby, il tuo amico virtuale. Puoi chiedermi qualsiasi cosa mentre i tuoi amici si uniscono a MindTheClub. A differenza di ogni altra chat di questa app, le mie risposte arrivano da un modello IA nel cloud — qui niente è peer-to-peer. Le tue altre conversazioni restano completamente private, come sempre.</string>
    <string name="assistant_disclosure_title">Prima di chattare con l\'Assistente</string>
    <string name="assistant_disclosure_text">I messaggi di questa chat vengono inviati a un modello IA nel cloud per generare le risposte. Questa chat NON è peer-to-peer e NON è crittografata end-to-end.\n\nTutte le altre conversazioni restano private e peer-to-peer, come sempre.\n\nNon condividere informazioni personali sensibili in questa chat.</string>
    <string name="assistant_disclosure_accept">Ho capito</string>
    <string name="assistant_text_only">Posso leggere solo messaggi di testo. Scrivimi qualcosa!</string>
    <string name="assistant_limit_user">Hai raggiunto il limite giornaliero di messaggi per l\'Assistente. Torna domani!</string>
    <string name="assistant_limit_global">L\'Assistente si sta prendendo una pausa per oggi. Riprova domani!</string>
    <string name="assistant_error_network">Non sono raggiungibile — controlla la connessione e riprova.</string>
    <string name="assistant_error_generic">Qualcosa è andato storto da parte mia. Riprova tra un momento.</string>

    <!-- Onboarding: battery restriction screen -->
    <string name="onboarding_battery_title">Un ultimo consiglio</string>
    <string name="onboarding_battery_body">È tutto pronto! Per la massima fluidità puoi lasciare che MindTheClub funzioni liberamente in background — consuma pochissima batteria. Del tutto facoltativo, e puoi cambiarlo in qualsiasi momento.</string>
    <string name="onboarding_battery_open_settings">Certo, mostrami</string>
    <string name="onboarding_battery_skip">Magari più tardi</string>

    <!-- Note to myself -->
    <string name="note_to_self">Nota per me</string>
    <string name="note_to_self_bio">Il tuo spazio privato — note, foto e file, salvati solo su questo telefono</string>
    <string name="show_note_to_self_help">“Nota per me” è il tuo spazio privato: una chat con te per note, foto e file, salvati solo su questo telefono. Quando questa opzione è disattivata, scompare dalla tua lista contatti e dai risultati di ricerca. Le tue note vengono conservate e riappaiono non appena la riattivi.</string>

    <!-- Subscription / billing -->
    <string name="subscription_title">Abbonamento</string>
    <string name="sub_standard_title">Standard</string>
    <string name="sub_standard_desc">Messaggistica privata completa: chat, chiamate e trasferimenti di file peer-to-peer illimitati, più una quota relay mensile per le reti difficili. Inizia con una prova gratuita di 30 giorni.</string>
    <string name="sub_stealth_title">Stealth</string>
    <string name="sub_stealth_desc">Tutto ciò che è incluso in Standard, più la modalità Stealth: tutte le connessioni passano attraverso un relay, così il tuo indirizzo IP non è mai visibile alle persone con cui parli — con una quota relay mensile più grande del 50%.</string>
