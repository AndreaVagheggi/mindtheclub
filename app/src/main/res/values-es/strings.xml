    <string name="stealth_mode_help">El modo sigiloso obliga al tráfico a pasar por un relé (TURN). Así se ocultan tus datos de red a la persona con la que chateas.</string>
    <string name="bluetooth_transport_help">Cuando está activado, MindTheClub puede entregar mensajes directamente por Bluetooth a un contacto cercano, sin internet, Wi-Fi ni datos móviles. Es útil cuando estás sin conexión o sin cobertura. La otra persona también debe tener el Bluetooth activado y estar vinculada con tu dispositivo.</string>
    <string name="auto_invite_mode_help">Cuando está activado, cualquier persona que escanee tu código QR o toque tu enlace de invitación se acepta automáticamente y se añade directamente a tu lista de contactos como pendiente. Ya no aparece en la pantalla de Nuevas solicitudes de contacto para aprobación manual. Desactívalo si prefieres revisar y aceptar cada solicitud tú mismo.</string>

    <!-- Onboarding -->
    <string name="onboarding_welcome">¡Bienvenido al club!</string>
    <string name="onboarding_subtitle">Mensajería privada, solo entre tú y las personas que elijas. Elige un nombre para empezar, siempre podrás cambiarlo más tarde.</string>
    <string name="onboarding_next">Siguiente</string>

    <!-- Onboarding: profile (picture + bio) -->
    <string name="onboarding_profile_title">Hazlo tuyo</string>
    <string name="onboarding_profile_subtitle">Añade una foto de perfil y una bio breve para que te reconozcan. Ambos son opcionales, toca Siguiente para omitir, puedes añadirlos cuando quieras.</string>

    <!-- Onboarding: invite friends -->
    <string name="onboarding_invite_title">Mejor con amigos</string>
    <string name="onboarding_invite_subtitle">MindTheClub te conecta directamente con las personas que invitas, y con nadie más. Envía tu primera invitación para empezar a chatear: es el paso que pone en marcha la conversación.</string>
    <string name="onboarding_invite_skip">Omitir por ahora</string>

    <!-- Onboarding: permission priming -->
    <string name="onboarding_perm_title">Antes de empezar</string>
    <string name="onboarding_perm_calls_title">Llamadas de voz y vídeo</string>
    <string name="onboarding_perm_calls_body">MindTheClub necesita tu micrófono y tu cámara para que podáis hablar y veros durante las llamadas. Si lo permites ahora, las llamadas funcionarán sin tener que autorizar nada a mitad de la llamada.</string>
    <string name="onboarding_perm_notif_title">Notificaciones</string>
    <string name="onboarding_perm_notif_body">Permite las notificaciones para no perderte ningún mensaje nuevo ni llamada entrante.</string>
