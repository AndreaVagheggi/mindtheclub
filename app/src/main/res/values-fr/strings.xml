    <!-- AI Assistant -->
    <string name="assistant_name">Clubby</string>
    <string name="show_clubby">Afficher Clubby</string>
    <string name="show_clubby_help">Clubby est l\'assistant IA intégré. Quand cette option est désactivée, Clubby disparaît de ta liste de contacts et des résultats de recherche. Ta conversation est conservée et revient dès que tu la réactives.</string>
    <string name="assistant_bio">Assistant IA — les messages de cette discussion sont traités par un modèle d\'IA, pas en pair-à-pair</string>
    <string name="assistant_welcome">Bonjour ! Je suis Clubby, ton ami virtuel. Tu peux tout me demander pendant que tes amis rejoignent MindTheClub. Contrairement à toutes les autres discussions de cette appli, mes réponses viennent d\'un modèle d\'IA dans le cloud — rien ici n\'est en pair-à-pair. Tes autres conversations restent totalement privées, comme toujours.</string>
    <string name="assistant_disclosure_title">Avant de discuter avec l\'Assistant</string>
    <string name="assistant_disclosure_text">Les messages de cette discussion sont envoyés à un modèle d\'IA dans le cloud pour générer les réponses. Cette discussion n\'est PAS en pair-à-pair et n\'est PAS chiffrée de bout en bout.\n\nToutes tes autres conversations restent privées et en pair-à-pair, comme toujours.\n\nNe partage pas d\'informations personnelles sensibles dans cette discussion.</string>
    <string name="assistant_disclosure_accept">J\'ai compris</string>
    <string name="assistant_text_only">Je ne peux lire que des messages texte. Écris-moi quelque chose !</string>
    <string name="assistant_limit_user">Tu as atteint la limite de messages du jour pour l\'Assistant. Reviens demain !</string>
    <string name="assistant_limit_global">L\'Assistant fait une pause pour aujourd\'hui. Réessaie demain !</string>
    <string name="assistant_error_network">Impossible de me joindre — vérifie ta connexion et réessaie.</string>
    <string name="assistant_error_generic">Quelque chose s\'est mal passé de mon côté. Réessaie dans un instant.</string>

    <!-- Onboarding: battery restriction screen -->
    <string name="onboarding_battery_title">Livraison fiable</string>
    <string name="onboarding_battery_why_title">Ton téléphone fait le travail</string>
    <string name="onboarding_battery_why_body">MindTheClub n\'a pas de serveurs : les messages voyagent directement de téléphone à téléphone. Quand Android met l\'appli en veille pour économiser la batterie, tes messages peuvent arriver en retard.</string>
    <string name="onboarding_battery_how_title">Réglé en un geste</string>
    <string name="onboarding_battery_how_body">Dans la page des réglages, choisis Batterie et mets MindTheClub sur Non restreinte. L\'appli consomme très peu d\'énergie — cela garantit seulement que tes messages arrivent à l\'heure.</string>
    <string name="onboarding_battery_open_settings">Ouvrir les réglages</string>
    <string name="onboarding_battery_skip">Pas maintenant</string>

    <!-- Note to myself -->
    <string name="note_to_self">Note à moi-même</string>
    <string name="note_to_self_bio">Ton espace privé — notes, photos et fichiers, stockés uniquement sur ce téléphone</string>
    <string name="show_note_to_self_help">« Note à moi-même » est ton espace privé : une discussion avec toi-même pour tes notes, photos et fichiers, stockés uniquement sur ce téléphone. Quand cette option est désactivée, elle disparaît de ta liste de contacts et des résultats de recherche. Tes notes sont conservées et reviennent dès que tu la réactives.</string>
</resources>
