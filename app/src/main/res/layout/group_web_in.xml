<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="4dp"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <include layout="@layout/date_header_chat"
        android:id="@+id/date_header"
        android:layout_width="wrap_content"
        android:layout_height="84dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone" />

    <!-- New selectable area container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/selectable_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/date_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


    <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_message"
            style="@style/InMessageCardViewStyle"
            android:layout_width="230dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="46dp"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:cardBackgroundColor="@color/white">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:paddingBottom="2dp"
                android:id="@+id/card_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/insert"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginStart="1dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="1dp"
                    android:background="@drawable/rounded_insert"
                    android:backgroundTint="@color/lightGray"
                    android:visibility="visible">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/insert_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="2dp">

                        <ImageView
                            android:id="@+id/image"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:scaleType="fitCenter"
                            android:adjustViewBounds="true"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/nameAttached"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:textStyle="bold"
                            app:layout_constraintTop_toBottomOf="@id/image"
                            app:layout_constraintStart_toStartOf="parent" />

                        <TextView
                            android:id="@+id/textAttached"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:maxLines="3"
                            android:ellipsize="end"
                            android:textStyle="italic"
                            app:layout_constraintTop_toBottomOf="@id/nameAttached"
                            app:layout_constraintStart_toStartOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autoLink="web"
                    android:linksClickable="true"
                    android:maxWidth="230dp"
                    android:padding="2dp"
                    android:layout_marginBottom="12dp"
                    android:textSize="16sp"
                    app:layout_constraintTop_toBottomOf="@id/insert"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/time_stamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/mtc_opaque"
                    android:textSize="11sp"
                    android:layout_marginEnd="2dp"
                    app:layout_constraintTop_toBottomOf="@id/message"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/forwarded"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:text="@string/forwarded"
                    android:textColor="@color/mtc_opaque"
                    android:textSize="11sp"
                    android:layout_marginStart="2dp"
                    app:layout_constraintTop_toBottomOf="@id/message"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/emoji"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:elevation="2dp"
            android:visibility="gone"
            android:gravity="center"
            android:textSize="18sp"
            android:textColor="@android:color/black"
            android:background="@drawable/circle_white_background"
            app:layout_constraintBottom_toBottomOf="@+id/card_message"
            app:layout_constraintStart_toStartOf="@+id/card_message"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="-16dp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/mtc_opaque"
            android:textSize="11sp"
            android:layout_marginTop="2dp"
            app:layout_constraintTop_toBottomOf="@+id/card_message"
            app:layout_constraintEnd_toEndOf="@+id/card_message"
            />

        <include
            android:id="@+id/member_header"
            layout="@layout/partial_chat_member_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintStart_toStartOf="@+id/card_message"
            app:layout_constraintBottom_toTopOf="@+id/card_message"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
