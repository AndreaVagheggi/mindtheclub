<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/MainLayout"
    android:theme="@style/MindTheClub"
    android:clickable="true"
    android:paddingBottom="10dp"
    android:paddingTop="10dp"
    android:background="?attr/selectableItemBackground"
    android:layout_height="wrap_content"
    android:layout_width="match_parent">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/peerImage"
        android:layout_width="@dimen/picSize"
        android:layout_height="@dimen/picSize"
        android:scaleType="centerCrop"
        android:src="@drawable/peer"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearance="@style/CircleShape" />

    <TextView
        android:id="@+id/unreadBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="18dp"
        android:minHeight="18dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:gravity="center"
        android:textColor="@android:color/white"
        android:textSize="11sp"
        android:textStyle="bold"
        android:background="@drawable/badge_background"
        android:visibility="gone"
        android:translationZ="1dp"
        app:layout_constraintEnd_toEndOf="@+id/peerImage"
        app:layout_constraintTop_toTopOf="@+id/peerImage" />

    <ImageView
        android:id="@+id/pending"
        android:contentDescription="@string/app_name"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:visibility="gone"
        app:layout_constraintStart_toEndOf="@+id/peerImage"
        app:layout_constraintTop_toBottomOf="@+id/peerImage"
        android:layout_marginStart="-22dp"
        android:layout_marginTop="-22dp"
        android:src="@drawable/pending"
        app:tint="@color/grey" />

    <TextView
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@+id/peerImage"
        app:layout_constraintStart_toEndOf="@+id/peerImage"
        android:layout_marginStart="10dp"
        android:layout_marginTop="4dp" />

    <!-- Group role badge. Gone by default: peer_item is shared with the peers,
         forward, message-info and reactions lists, and only the group member
         list ever makes it visible. -->
    <TextView
        android:id="@+id/roleBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:text="@string/admin_label"
        android:textColor="@color/primary_dark"
        android:textSize="10sp"
        android:textStyle="bold"
        android:background="@drawable/reaction_pill_background"
        android:visibility="gone"
        app:layout_constraintStart_toEndOf="@+id/name"
        app:layout_constraintTop_toTopOf="@+id/name"
        app:layout_constraintBottom_toBottomOf="@+id/name" />

    <TextView
        android:id="@+id/lastMessage"
        android:textColor="@color/darkGray"
        android:layout_width="0dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginRight="8dp"
        app:layout_constraintTop_toBottomOf="@+id/name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/name" />


    <TextView
        android:id="@+id/lastMessageDate"
        android:textColor="@color/darkGray"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="@+id/name"
        app:layout_constraintRight_toRightOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>