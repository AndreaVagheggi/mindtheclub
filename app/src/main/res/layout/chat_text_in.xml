<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingBottom="4dp">

    <include
        android:id="@+id/date_header"
        layout="@layout/date_header_chat"
        android:layout_width="wrap_content"
        android:layout_height="84dp"
        android:layout_marginTop="24dp"
        android:clickable="false"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/selectable_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/date_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


    <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_message"
            style="@style/InMessageCardViewStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="8dp"
            android:minWidth="80dp"
            android:maxWidth="260dp"
            app:cardBackgroundColor="@color/white"
            app:cardUseCompatPadding="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.bolimot.mindtheclub.customViews.BubbleColumnLayout
                android:id="@+id/card_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="68dp"
                android:maxWidth="260dp"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/reply_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rounded_in"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/insert_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxWidth="200dp"
                        android:maxLines="1"
                        android:textStyle="bold|italic"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/insert_message"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxWidth="200dp"
                        android:maxLines="2"
                        android:textStyle="italic"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/insert_name" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:clickable="false"
                    android:maxWidth="260dp"
                    android:padding="4dp"
                    android:textSize="16sp" />

                <!-- FrameLayout on purpose: it is the only stock container that
                     measures HONESTLY under BubbleColumnLayout (wraps to its widest
                     child). RelativeLayout with alignParentEnd and LinearLayout
                     with layout_weight both report the FULL available width when
                     wrap-measured, inflating every bubble to the max. When this
                     row is stretched, layout_gravity puts the timestamp at the
                     right edge. -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/forwarded"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="4dp"
                        android:text="@string/forwarded"
                        android:textColor="@color/mtc_opaque"
                        android:textSize="11sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/time_stamp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="2dp"
                        android:textColor="@color/mtc_opaque"
                        android:textSize="11sp" />
                </FrameLayout>

            </com.bolimot.mindtheclub.customViews.BubbleColumnLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/emoji"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="-16dp"
            android:background="@drawable/circle_white_background"
            android:elevation="2dp"
            android:gravity="center"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/card_message"
            app:layout_constraintStart_toStartOf="@+id/card_message" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/mtc_opaque"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="@+id/card_message"
            app:layout_constraintTop_toBottomOf="@+id/card_message" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>