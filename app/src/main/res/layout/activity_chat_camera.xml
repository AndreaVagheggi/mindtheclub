<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Photo"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="16dp"/>

    <View
        android:id="@+id/center"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/app_name"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="invisible"
        />

    <ImageButton

        android:id="@+id/btnCapture"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/ic_camera_button"
        android:scaleType="fitCenter"
        android:contentDescription="@string/app_name"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:alpha="0.8"
        />

    <ImageButton
        android:id="@+id/btnCaptureVideo"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/ic_camera_button_video"
        android:scaleType="fitCenter"
        android:contentDescription="@string/app_name"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:alpha="0.8"

        />

    <ImageButton
        android:id="@+id/btnCaptureStop"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/ic_camera_button_stop"
        android:scaleType="fitCenter"
        android:contentDescription="@string/app_name"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:alpha="0.8"
        />

    <ImageButton
        android:id="@+id/btnSwitchPhoto"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/camera"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:contentDescription="@string/app_name"
        android:layout_marginBottom="12dp"
        android:layout_marginEnd="84dp"
        android:visibility="visible"
        android:alpha="0.8"
        app:tint="@color/red"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/center"
        />

    <ImageButton
        android:id="@+id/btnSwitchVideo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@android:color/transparent"
        android:src="@drawable/video"
        android:scaleType="fitCenter"
        android:contentDescription="@string/app_name"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="84dp"
        android:visibility="visible"
        android:alpha="0.8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/center"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <ImageButton
        android:id="@+id/btnSwitch"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@android:color/transparent"
        android:src="@drawable/camera_switch"
        android:scaleType="fitCenter"
        android:contentDescription="@string/app_name"
        android:layout_margin="16dp"
        android:visibility="visible"
        android:alpha="0.8"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>
