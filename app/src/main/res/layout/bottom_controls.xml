<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/bottom_controls_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"
        android:baselineAligned="false"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Floating Toolbar with grouped controls using FrameLayout -->
        <FrameLayout
            android:id="@+id/controls_toolbar"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="16dp"
            android:background="@drawable/toolbar_background"
            android:elevation="4dp"
            tools:ignore="UselessParent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <!-- Speaker Button -->
                <ImageButton
                    android:id="@+id/speaker_on_off"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/accept"
                    android:src="@drawable/speaker_on"
                    android:scaleType="centerInside"
                    app:tint="#FFFFFF" />

                <!-- Camera Switch Button -->
                <ImageButton
                    android:id="@+id/camera_front_rear"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/missed_call"
                    android:src="@drawable/camera_rear"
                    android:scaleType="centerInside"
                    app:tint="#FFFFFF" />

                <!-- PiP Button -->
                <ImageButton
                    android:id="@+id/pip_mode"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/app_version"
                    android:src="@drawable/pip"
                    android:scaleType="centerInside"
                    app:tint="#FFFFFF" />

            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>