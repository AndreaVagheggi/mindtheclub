<?xml version="1.0" encoding="utf-8"?>
<!--
    One participant. The renderer sits at the bottom of the stack and everything
    else is painted over it, so a tile with no picture yet still shows the avatar
    and the name instead of a black rectangle.
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tile_card"
    android:layout_width="match_parent"
    android:layout_height="160dp"
    android:layout_margin="3dp"
    app:cardBackgroundColor="#1F1F1F"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/tile_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/tile_avatar_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/tile_avatar"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/app_name"
                android:scaleType="centerCrop"
                android:src="@drawable/peer"
                app:shapeAppearance="@style/CircleShape"
                app:strokeColor="@android:color/white"
                app:strokeWidth="1dp" />

        </LinearLayout>

        <View
            android:id="@+id/tile_speaking"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/tile_speaking_border"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/tile_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="6dp"
            android:background="@drawable/call_label_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/tile_mic_off"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@string/muted"
                android:src="@drawable/microphone_off"
                android:visibility="gone"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tile_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxWidth="120dp"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tile_reaction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="42sp"
            android:visibility="gone" />

    </FrameLayout>

</androidx.cardview.widget.CardView>
