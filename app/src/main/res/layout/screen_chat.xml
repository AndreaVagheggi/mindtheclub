<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:background="@drawable/chat_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <LinearLayout
        android:id="@+id/bottom_controls_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:elevation="4dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"
        android:baselineAligned="false"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/chat_input"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/controls_toolbar"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginEnd="16dp"
            android:background="@drawable/toolbar_chat_background"
            android:elevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <Button
                    android:id="@+id/attach_image"
                    style="?attr/borderlessButtonStyle"
                    android:textAllCaps="false"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableTop="@drawable/image"
                    android:text="@string/images"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    app:drawableTint="#FFFFFF" />

                <Button
                    android:id="@+id/attach_video"
                    style="?attr/borderlessButtonStyle"
                    android:textAllCaps="false"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableTop="@drawable/movie"
                    android:text="@string/video"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    app:drawableTint="#FFFFFF" />

                <Button
                    android:id="@+id/attach_file"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:textAllCaps="false"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableTop="@drawable/file"
                    android:text="@string/file"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    app:drawableTint="#FFFFFF" />

                <Button
                    android:id="@+id/attach_contact"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:textAllCaps="false"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableTop="@drawable/contact"
                    android:text="@string/contact"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    app:drawableTint="#FFFFFF" />

            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/gotoBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        android:contentDescription="@string/accept"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="76dp"
        android:layout_marginEnd="8dp"
        android:alpha="0.4"
        android:src="@drawable/down"
        app:backgroundTint="@color/grey"
        android:tint="@color/black"
        app:fabSize="mini"
        />


    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_opaque"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:theme="@style/CustomToolbarTheme"
            android:layout_height="?attr/actionBarSize">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/profilePic"
                    android:contentDescription="@string/app_name"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@drawable/peer"
                    android:scaleType="centerCrop"
                    android:background="@drawable/custom_ripple"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:shapeAppearance="@style/CircleShape"/>

                <TextView
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    app:layout_constraintStart_toEndOf="@id/profilePic"
                    app:layout_constraintTop_toTopOf="@+id/profilePic"
                    />

                <TextView
                    android:id="@+id/typing"
                    android:text="@string/typing"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textStyle="italic"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    app:layout_constraintStart_toEndOf="@id/profilePic"
                    app:layout_constraintBottom_toBottomOf="@+id/profilePic"
                    />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.appbar.MaterialToolbar>

        <LinearLayout
            android:id="@+id/searchContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="20dp"
            android:layout_marginTop="4dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/searchEditText"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/search_bar_background"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="8dp"
                android:hint="@string/search"
                android:textColorHint="#999999"
                android:textColor="#000000"
                android:textSize="16sp"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:importantForAutofill="no" />

            <ImageButton
                android:id="@+id/searchClose"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_clear"
                android:contentDescription="@string/close"
                app:tint="@color/white" />

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <com.bolimot.mindtheclub.customViews.MyCustomRecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="12dp"
        android:layout_marginTop="8dp"
        android:scrollbars="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout"
        app:layout_constraintBottom_toTopOf="@+id/chat_input"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
    </com.bolimot.mindtheclub.customViews.MyCustomRecyclerView>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/chat_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:fitsSystemWindows="true">

        <com.google.android.material.bottomappbar.BottomAppBar
            android:id="@+id/bottomAppBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:backgroundTint="@color/primary_opaque"
            app:fabAlignmentMode="center"
            app:hideOnScroll="true"
            android:fitsSystemWindows="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/inputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="@android:color/transparent"
                app:layout_constraintBottom_toBottomOf="parent">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/recordingView"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:visibility="gone"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="48dp"
                    android:backgroundTint="@color/white"
                    android:background="@drawable/rounded_edittext"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/recordLayout"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <ImageView
                            android:id="@+id/recordingImage"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginStart="24dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:src="@drawable/microphone"
                            app:tint="@color/red"/>

                        <Chronometer
                            android:id="@+id/recordingChronometer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@android:color/black"
                            android:textSize="16sp"
                            android:visibility="visible"
                            android:format="%s"
                            android:layout_marginStart="12dp"
                            app:layout_constraintStart_toEndOf="@+id/recordingImage"
                            app:layout_constraintTop_toTopOf="@+id/recordingImage"
                            app:layout_constraintBottom_toBottomOf="@+id/recordingImage"/>

                        <ImageButton
                            android:id="@+id/cancelRecording"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/custom_ripple"
                            android:src="@drawable/delete"
                            android:contentDescription="@string/send"
                            android:visibility="gone"
                            app:layout_constraintStart_toEndOf="@+id/recordingChronometer"
                            app:layout_constraintTop_toTopOf="@+id/recordingImage"
                            app:layout_constraintBottom_toBottomOf="@+id/recordingImage"
                            app:tint="@color/black"/>

                        <ImageButton
                            android:id="@+id/cancel"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/custom_ripple"
                            android:src="@drawable/delete"
                            android:contentDescription="@string/send"
                            android:visibility="gone"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/recordingImage"
                            app:layout_constraintBottom_toBottomOf="@+id/recordingImage"
                            android:layout_marginEnd="48dp"
                            app:tint="@color/grey"/>

                        <ImageButton
                            android:id="@+id/rewind"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/rewind"
                            android:background="@color/white"
                            android:contentDescription="@string/send"
                            android:visibility="gone"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/recordingImage"
                            app:layout_constraintBottom_toBottomOf="@+id/recordingImage"
                            android:layout_marginEnd="12dp"
                            app:tint="@color/grey"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/chat_layout_background"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:orientation="vertical"
                    android:background="@drawable/rounded_edittext"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/microphone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>


                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/chat_insert"
                    android:layout_width="250dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="94dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/rounded_insert"
                    android:backgroundTint="@color/lightGray"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/camera">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">

                        <ImageButton
                            android:id="@+id/close_with_background"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:background="@drawable/circle_gray_background"
                            android:src="@drawable/close"
                            android:contentDescription="@string/app_name"
                            android:padding="2dp"
                            android:elevation="4dp"
                            android:visibility="gone"
                            app:tint="@android:color/black"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageButton
                            android:id="@+id/close"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/custom_ripple"
                            android:src="@drawable/close"
                            android:contentDescription="@string/app_name"
                            android:padding="8dp"
                            android:visibility="gone"
                            app:tint="@color/black"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />


                        <ImageView
                            android:id="@+id/chat_imageAttached"
                            android:layout_width="40dp"
                            android:layout_height="0dp"
                            android:scaleType="centerCrop"
                            android:contentDescription="@string/app_name"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <ImageView
                            android:id="@+id/camera_icon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/video"
                            app:layout_constraintStart_toStartOf="@+id/chat_imageAttached"
                            app:layout_constraintBottom_toBottomOf="@+id/chat_imageAttached"
                            android:layout_marginStart="2dp"
                            android:layout_marginBottom="2dp"
                            android:contentDescription="@string/app_name"
                            android:visibility="gone"
                            android:padding="2dp" />

                        <LinearLayout
                            android:id="@+id/text_container"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/chat_imageAttached"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <TextView
                                android:id="@+id/chat_nameAttached"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textStyle="bold"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                android:maxLines="1"
                                android:ellipsize="end" />

                            <TextView
                                android:id="@+id/chat_textAttached"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textStyle="italic"
                                android:textColor="@color/black"
                                android:textSize="14sp"
                                android:maxLines="3"
                                android:ellipsize="end" />

                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>


                <com.bolimot.mindtheclub.customViews.RichEditText
                    android:id="@+id/editTextMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:hint="@string/message"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences|textMultiLine"
                    android:padding="10dp"
                    android:scrollbars="vertical"
                    android:textColor="@android:color/black"
                    android:textColorHint="@android:color/darker_gray"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/attach"
                    app:layout_constraintStart_toStartOf="@+id/chat_layout_background"
                    app:layout_constraintTop_toBottomOf="@id/chat_insert" />

                <ImageButton
                    android:id="@+id/camera"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/custom_ripple"
                    android:contentDescription="@string/camera"
                    android:padding="8dp"
                    android:src="@drawable/camera"
                    app:layout_constraintBottom_toBottomOf="@id/editTextMessage"
                    app:layout_constraintEnd_toStartOf="@id/attach"
                    app:layout_constraintTop_toTopOf="@id/editTextMessage"
                    app:tint="@color/grey" />

                <ImageButton
                    android:id="@+id/attach"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/custom_ripple"
                    android:contentDescription="@string/attach"
                    android:padding="8dp"
                    android:src="@drawable/attach"
                    app:layout_constraintBottom_toBottomOf="@id/editTextMessage"
                    app:layout_constraintEnd_toEndOf="@+id/chat_layout_background"
                    app:layout_constraintTop_toTopOf="@id/editTextMessage"
                    app:tint="@color/grey" />


                <RelativeLayout
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@+id/microphone"
                    app:layout_constraintEnd_toEndOf="@+id/microphone"
                    app:layout_constraintBottom_toTopOf="@+id/microphone"/>

                <com.bolimot.mindtheclub.customViews.AccessibleImageButton
                    android:id="@+id/microphone"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/custom_ripple"
                    android:src="@drawable/microphone"
                    android:contentDescription="@string/microphone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:tint="@color/white" />

                <com.bolimot.mindtheclub.customViews.AccessibleImageButton
                    android:id="@+id/microphone_active"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/circle_gray_background"
                    android:src="@drawable/microphone"
                    android:visibility="invisible"
                    android:contentDescription="@string/microphone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:tint="@color/white" />

                <ImageButton
                    android:id="@+id/send"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/custom_ripple"
                    android:src="@drawable/send"
                    android:contentDescription="@string/send"
                    android:visibility="invisible"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:tint="@color/white" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.bottomappbar.BottomAppBar>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/locking_view"
        android:layout_width="42dp"
        android:layout_height="84dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="12dp"
        style="@style/Widget.MaterialComponents.CardView"
        app:shapeAppearance="@style/HorizontalCapsuleShapeAppearance"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/chat_input">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/black"
                app:tint="@color/grey"
                android:visibility="visible"
                android:elevation="2dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_centerHorizontal="true"
                android:src="@drawable/lock"/>

            <ImageView
                android:id="@+id/up"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginBottom="8dp"
                android:backgroundTint="@color/grey"
                app:tint="@color/grey"
                android:visibility="visible"
                android:elevation="2dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_centerHorizontal="true"
                android:src="@drawable/up"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>