<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:keepScreenOn="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/app_name"
        android:elevation="2dp"
        android:scaleType="centerCrop"
        android:src="@drawable/blur2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ImageContrastCheck" />

     <!-- Camera Switch Button -->
    <ImageButton
        android:id="@+id/camera_front_rear"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:background="@drawable/circle_border"
        android:contentDescription="@string/camera"
        android:elevation="2dp"
        android:visibility="invisible"
        android:src="@drawable/camera_front"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white"
        tools:ignore="ImageContrastCheck" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/profilePic"
        android:contentDescription="@string/app_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:elevation="2dp"
        android:scaleType="centerCrop"
        android:layout_width="120dp"
        android:layout_height="120dp"
        app:strokeColor="@android:color/white"
        app:strokeWidth="2dp"
        android:src="@drawable/peer"
        app:shapeAppearance="@style/CircleShape"/>

    <TextView
        android:id="@+id/connecting_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/connecting"
        android:textColor="@color/white"
        android:elevation="2dp"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profilePic"
    />

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/remote_video_view"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
    />

    <FrameLayout
        android:id="@+id/your_on_hold_overlay_id"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#A6000000"
        android:elevation="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/call_on_hold"
                android:src="@drawable/pause"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/call_on_hold"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

    </FrameLayout>

    <FrameLayout
        android:id="@+id/reconnecting_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#A6000000"
        android:elevation="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/reconnecting"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

    </FrameLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/local_video_card"
        android:layout_width="124dp"
        android:layout_height="160dp"
        android:visibility="invisible"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottom_controls_container"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="12dp">

        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/local_video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.cardview.widget.CardView>

    <!--
        The elevation keeps the controls above the 2dp layer that appears when the peer
        turns their camera off: the full screen background would otherwise paint straight
        over them, leaving the call with no reachable buttons at all. The 4dp and 6dp on
        the children below are relative to this container, so they cannot do that job.
        Stays under the 10dp hold and reconnecting overlays, which must cover everything.
    -->
    <LinearLayout
        android:id="@+id/bottom_controls_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Floating Toolbar with grouped controls using FrameLayout -->
        <FrameLayout
            android:id="@+id/controls_toolbar"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="16dp"
            android:background="@drawable/toolbar_background"
            android:elevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageButton
                    android:id="@+id/camera_on_off"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/camera"
                    android:src="@drawable/video"
                    android:scaleType="centerInside"
                    app:tint="#FFFFFF" />

                <!-- Speaker Button -->
                <ImageButton
                    android:id="@+id/speaker_on_off"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/camera"
                    android:src="@drawable/speaker_on"
                    android:scaleType="centerInside"
                    app:tint="#FFFFFF" />

                <!-- PiP Button -->
                <ImageButton
                    android:id="@+id/pip_mode"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:importantForAccessibility="no"
                    android:src="@drawable/pip"
                    android:scaleType="centerInside"
                    app:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/on_hold_on_off"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:importantForAccessibility="no"
                    android:src="@drawable/pause"
                    android:scaleType="centerInside"
                    app:tint="#FFFFFF" />

            </LinearLayout>

        </FrameLayout>

        <!-- End Call Button (Simple version) -->
        <FrameLayout
            android:id="@+id/fab_close_container"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/fab_background"
            android:elevation="6dp">

            <ImageButton
                android:id="@+id/fab_close"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:importantForAccessibility="no"
                android:src="@drawable/phone_hangup"
                android:scaleType="centerInside"
                app:tint="#FFFFFF" />

        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>