<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="4dp"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <include layout="@layout/date_header_chat"
        android:id="@+id/date_header"
        android:layout_width="wrap_content"
        android:layout_height="84dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone" />

    <!-- New selectable area container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/selectable_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/date_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


    <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_message"
            style="@style/InMessageCardViewStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="42dp"
            android:layout_marginTop="46dp"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:cardBackgroundColor="@color/mtc_opaque">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/profilePic"
                    android:contentDescription="@string/app_name"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginLeft="4dp"
                    android:scaleType="centerCrop"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/peer"
                    app:shapeAppearance="@style/CircleShape"/>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/mic"
                    android:contentDescription="@string/app_name"
                    app:layout_constraintStart_toEndOf="@+id/profilePic"
                    app:layout_constraintTop_toBottomOf="@+id/profilePic"
                    android:layout_marginLeft="-20dp"
                    android:layout_marginTop = "-16dp"
                    android:tint="@color/white"
                    android:scaleType="centerCrop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/microphone"
                    app:shapeAppearance="@style/CircleShape"/>

                <ImageButton
                    android:id="@+id/play"
                    android:src="@drawable/play"
                    app:layout_constraintStart_toEndOf="@+id/profilePic"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="230dp"
                    android:padding="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/app_name"/>

                <ProgressBar
                    android:id="@+id/progress"
                    android:layout_width="135dp"
                    android:layout_height="6dp"
                    app:layout_constraintTop_toTopOf="@+id/play"
                    app:layout_constraintBottom_toBottomOf="@+id/play"
                    app:layout_constraintLeft_toRightOf="@+id/play"
                    android:progressBackgroundTint="@color/icons"
                    android:progressTint="@color/mtc_accent"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:progress="0" />

                <TextView
                    android:id="@+id/time_stamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/icons"
                    android:textSize="11sp"
                    android:layout_marginEnd="2dp"
                    android:layout_marginBottom="2dp"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@+id/progress"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/emoji"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:elevation="2dp"
            android:visibility="gone"
            android:gravity="center"
            android:textSize="18sp"
            android:textColor="@android:color/black"
            android:background="@drawable/circle_white_background"
            app:layout_constraintBottom_toBottomOf="@+id/card_message"
            app:layout_constraintStart_toStartOf="@+id/card_message"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="-16dp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/mtc_opaque"
            android:textSize="11sp"
            android:layout_marginTop="2dp"
            app:layout_constraintTop_toBottomOf="@+id/card_message"
            app:layout_constraintEnd_toEndOf="@+id/card_message"
            />

        <include
            android:id="@+id/member_header"
            layout="@layout/partial_audio_chat_member_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintStart_toStartOf="@+id/card_message"
            app:layout_constraintBottom_toTopOf="@+id/card_message"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
